# ══════════════════════════════════════════════════════════════════
#  onecpaas-voice-dashboard — Backend Environment Configuration
#  Copy this file to .env and fill in the values.
#  DO NOT commit .env to git.
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
# NODE_ENV: 'production' or 'development'
NODE_ENV=development

# PORT: HTTP port this backend listens on
PORT=3000

# BASE_URL / APP_URL: public URL of this backend (used in links, callbacks etc.)
BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ALLOWED_ORIGINS: CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001


# ── MySQL Database ────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=voice_dashboard


# ── Redis (BullMQ queues) ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379


# ── Auth / Security ───────────────────────────────────────────────
# JWT_SECRET: secret key used to sign and verify JWT tokens.
#   Generate: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# ENCRYPTION_KEY: AES-256-GCM key for encrypting stored credentials.
#   Must be exactly 64 hex characters (32 bytes).
#   Generate: openssl rand -hex 32
ENCRYPTION_KEY=your_64_hex_char_key_here

# LEGACY_API_JWT_SECRET: HMAC secret for the partner/third-party API token
#   minted from POST /profile/api-token.
LEGACY_API_JWT_SECRET=change_me


# ── Voice Dial Engine ─────────────────────────────────────────────
# This backend has no dial engine of its own — the voice dispatch worker
# forwards every campaign here (POST {VOICE_ENGINE_API_URL}/v1/voice/send).
VOICE_ENGINE_API_URL=
VOICE_ENGINE_API_TOKEN=

# VOICE_ENGINE_WEBHOOK_SECRET: shared secret the voice engine sends back
#   when it calls POST /api/v1/voice/webhook/status with a call outcome.
#   Must match what's configured on the engine side for this tenant.
VOICE_ENGINE_WEBHOOK_SECRET=


# ── Media Processing ──────────────────────────────────────────────
# FFMPEG_PATH / FFPROBE_PATH: absolute paths to the ffmpeg/ffprobe binaries,
#   used to probe/transcode uploaded IVR audio. Leave blank to use whatever
#   is on $PATH.
FFMPEG_PATH=
FFPROBE_PATH=


# ── Worker Process ────────────────────────────────────────────────
# RUN_SINGLETON_WORKERS: set to "1" on exactly ONE of the worker PM2
#   processes (see ecosystem.config.cjs) — some scheduled jobs must run
#   only once across all worker instances.
RUN_SINGLETON_WORKERS=1
