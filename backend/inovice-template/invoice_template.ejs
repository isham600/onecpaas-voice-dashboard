<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Tax Invoice <%= invoice?.invoiceNo || '' %></title>
<style>
  * { box-sizing: border-box; }
  body { font-family: Arial, sans-serif; font-size: 11px; color: #000; margin: 0; padding: 20px; background: #fff; }
  .page { max-width: 800px; margin: 0 auto; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  td, th { border: 1px solid #000; padding: 4px 6px; vertical-align: top; word-wrap: break-word; }
  .center { text-align: center; }
  .right { text-align: right; }
  .bold { font-weight: bold; }
  .title-bar { text-align: center; font-size: 16px; font-weight: bold; margin-bottom: 5px; }
  .no-border { border: none !important; }
  .small { font-size: 10px; }
  
  .items-table td, .items-table th { border: 1px solid #000; border-top: none; border-bottom: none; }
  .items-table th { border-bottom: 1px solid #000; border-top: 1px solid #000; background-color: #fff;}
  .items-table .bottom-border { border-bottom: 1px solid #000; border-top: 1px solid #000;}
</style>
</head>
<body>
<div class="page">
  <div class="title-bar">Tax Invoice</div>

  <table style="border: 2px solid #000;">
    <!-- Seller & Invoice Meta -->
    <tr>
      <td style="width: 45%; padding: 0;" rowspan="2">
        <div style="padding: 4px; border-bottom: 1px solid #000; height: 100px;">
          <table style="width: 100%; border: none; padding: 0; margin: 0; table-layout: auto;">
            <tr>
              <td style="border: none; padding: 0; vertical-align: top;">
                <div class="bold" style="font-size:13px;"><%= seller?.name || '' %></div>
                <div><%= seller?.address || '' %></div>
                <div><%= seller?.email || '' %><% if(seller?.phone) { %> <%= seller.phone %><% } %></div>
                <div>GSTIN/UIN: <%= seller?.gstin || '' %></div>
              </td>
            </tr>
          </table>
        </div>

        <div style="padding: 4px; height: 110px;">
          <div>Buyer (Bill to)</div>
          <div class="bold"><%= buyer?.name || '' %></div>
          <div><%= buyer?.address || '' %></div>
          <div><%= buyer?.email || '' %><% if(buyer?.phone) { %>, Tel.<%= buyer.phone %><% } %></div>
          <div>GSTIN/UIN : <%= buyer?.gstin || '' %></div>
        </div>
      </td>
      <td style="width: 27.5%; padding: 0;">
        <div style="padding: 4px; border-bottom: 1px solid #000;">
          <div>Invoice No.</div>
          <div class="bold"><%= invoice?.invoiceNo || '' %></div>
        </div>
        <div style="padding: 4px;">
          <div>Delivery Note</div>
          <div class="bold"><%= invoice?.deliveryNote || '' %></div>
        </div>
      </td>
      <td style="width: 27.5%; padding: 0;">
        <div style="padding: 4px; border-bottom: 1px solid #000;">
          <div>Dated</div>
          <div class="bold"><%= invoice?.invoiceDate || '' %></div>
        </div>
        <div style="padding: 4px;">
          <div>Mode/Terms of Payment</div>
          <div class="bold"><%= invoice?.paymentTerms || '' %></div>
        </div>
      </td>
    </tr>
  </table>
  
  <table class="items-table" style="border: 2px solid #000; border-top: none;">
    <thead>
      <tr>
        <th style="width: 5%;">Sl<br>No.</th>
        <th style="width: 45%;">Description of<br>Services</th>
        <th style="width: 8%;">GST<br>Rate</th>
        <th style="width: 13%;">Quantity</th>
        <th style="width: 9%;">Rate</th>
        <th style="width: 5%;">per</th>
        <th style="width: 15%;">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% let totalQty = 0; %>
      <% (items || []).forEach(function(item, index) { %>
      <% totalQty += Number(item.quantity) || 0; %>
      <tr>
        <td class="center"><%= index + 1 %></td>
        <td>
          <div class="bold"><%= item.description || '' %></div>
        </td>
        <td class="center"><%= item.gstRate || '' %></td>
        <td class="right"><span class="bold"><%= Number(item.quantity || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span> UNIT</td>
        <td class="right" style="white-space: nowrap;"><%= Number(item?.rate || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
        <td class="center" style="white-space: nowrap;"><%= item?.per || 'UNIT' %></td>
        <td class="right bold" style="white-space: nowrap;"><%= Number(item?.amount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
      </tr>
      <% }); %>
      
      <!-- Tax items -->
      <% let totalTaxAmount = invoice?.totalTaxAmount || 0; %>
      <% if (totalTaxAmount > 0) { %>
      <tr>
        <td></td>
        <td class="right bold">Tax</td>
        <td></td><td></td><td></td><td></td>
        <td class="right bold"><%= Number(totalTaxAmount).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
      </tr>
      <% } %>

      <% let totalDiscount = invoice?.totalDiscount || 0; %>
      <% if (totalDiscount > 0) { %>
      <tr>
        <td></td>
        <td class="right bold">Discount</td>
        <td></td><td></td><td></td><td></td>
        <td class="right bold">- <%= Number(totalDiscount).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
      </tr>
      <% } %>

      <tr style="height: 150px;">
        <td></td><td></td><td></td><td></td><td></td><td></td><td></td>
      </tr>
    </tbody>
    <tfoot>
      <tr class="bottom-border">
        <td></td>
        <td class="right">Total</td>
        <td></td>
        <td class="right bold"><%= totalQty.toLocaleString('en-IN', {minimumFractionDigits: 2}) %> UNIT</td>
        <td></td>
        <td></td>
        <td class="right bold" style="font-size: 14px;">₹ <%= Number(invoice?.grandTotal || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
      </tr>
    </tfoot>
  </table>

  <!-- Amount in words -->
  <table style="border: 2px solid #000; border-top: none;">
    <tr>
      <td style="border: none;">
        Amount Chargeable (in words)<br>
        <span class="bold" style="font-size: 12px;">INR <%= invoice?.amountInWords || (invoice?.grandTotal || 0) + ' Only' %></span>
      </td>
      <td style="border: none; vertical-align: bottom;" class="right">
      </td>
    </tr>
  </table>



  <!-- Declaration + Bank details + Signatory -->
  <table style="border: 2px solid #000; border-top: none; table-layout: fixed;">
    <tr>
      <td style="width: 50%; border-right: 1px solid #000; border-top: none; vertical-align: bottom; padding: 6px;">
        <% if (invoice?.clientNote) { %>
        <div class="small"><%= invoice.clientNote %></div>
        <% } else { %>
        <div class="small">Declaration</div>
        <div class="small">
          We declare that this invoice shows the actual price of<br>
          the goods described and that all particulars are true<br>
          and correct.
        </div>
        <% } %>
      </td>
      <td style="width: 50%; border-top: none; text-align: right; vertical-align: bottom; padding: 0;">
        <% if (bank && bank.name) { %>
        <table style="margin-left: 20%; width: 80%; text-align: left; margin-bottom: 8px;">
            <tr>
              <td class="no-border small" style="padding: 2px;">Company's Bank Details</td><td class="no-border" style="padding: 2px;"></td>
            </tr>
            <tr>
              <td class="no-border small" style="padding: 2px;">Bank Name</td><td class="no-border small" style="padding: 2px;">: <span class="bold"><%= bank.name %></span></td>
            </tr>
            <tr>
              <td class="no-border small" style="padding: 2px;">A/c No.</td><td class="no-border small" style="padding: 2px;">: <span class="bold"><%= bank.accountNo %></span></td>
            </tr>
            <tr>
              <td class="no-border small" style="padding: 2px;">Branch & IFS Code</td><td class="no-border small" style="padding: 2px;">: <span class="bold"><%= bank.branch %></span></td>
            </tr>
        </table>
        <% } %>
        <div style="border-top: <% if (bank && bank.name) { %>1px solid #000<% } else { %>none<% } %>; padding: 6px; height: 60px; position: relative;">
          <div style="position: absolute; top: 6px; right: 6px; bottom: 6px; text-align: center; display: flex; flex-direction: column; justify-content: space-between;">
            <div class="bold"><%= (seller?.name || 'INDEW TECHNOLOGY').toUpperCase() %></div>
            <div style="font-weight: normal; font-size: 11px;">SIGNATURE</div>
          </div>
        </div>
      </td>
    </tr>
  </table>
  <div class="center" style="font-size: 10px; margin-top: 4px;">
    <%= invoice?.termsOfDelivery || '' %>
  </div>
</div>
</body>
</html>
