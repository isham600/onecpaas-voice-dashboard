# Example environment variables for this project
# Copy this file to `.env.local` and replace the values with your own.

# Base URL of the backend API (see backend/.env.example -> BASE_URL)
VITE_API_BASE_URL=http://localhost:3000
VITE_BASE_URL=http://localhost:3000
VITE_AUTH_BASE_URL=http://localhost:3000

# Additional backend service endpoints used by specific pages
VITE_BASE_URL2_URL=
VITE_SERVICE_URL=
VITE_SERVICE3_URL=

# Support desk integration (Support container)
VITE_SUPPORT_API_BASE_URL=
VITE_SUPPORT_PLATFORM=
